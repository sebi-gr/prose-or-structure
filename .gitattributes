# Active prompt/profile bytes must match the LF templates on every platform.
resources/*.txt text eol=lf
resources/*.md text eol=lf
resources/*.json text eol=lf
docs/*.tex text eol=lf
*.pdf binary

# Preserve the archived evidence bytes on Windows and Unix checkouts.
data/runs/VUL4J-18-review-001/* -text
data/annotations/VUL4J-18-review-001/* -text
# The original Windows prompt intentionally retains CRLF line endings.
data/runs/VUL4J-18-review-001/review_prompt_v1.txt whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Provider whitespace belongs to the hashed raw response and must stay intact.
data/runs/VUL4J-18-review-001/generation_raw.json -whitespace

# Verbatim third-party profile-development material; hashes use original bytes.
resources/profile_development/code/* -text -whitespace
resources/profile_development/*LICENSE*.txt -text
resources/profile_development/*NOTICE*.txt -text
resources/baselines/veriscore_extraction_non_qa.txt -text -whitespace
resources/baselines/VERISCORE_LICENSE -text
